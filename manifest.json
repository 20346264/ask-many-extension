{
  "manifest_version": 3,
  "name": "同问 AI · 多模型工作台",
  "version": "1.1.0",
  "description": "在一个页面里并排多个 AI，一次提问全部作答，自动拼装对比报告。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.deepseek.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://chat.qwen.ai/*",
    "https://yuanbao.tencent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开同问 AI 工作台",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.qwen.ai/*",
        "https://yuanbao.tencent.com/*"
      ],
      "js": ["adapters.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.js", "adapters.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
